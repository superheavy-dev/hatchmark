{
  "name": "hatchmark-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "lint": "node scripts/check-no-js.ts && biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "gen:schema": "pnpm --filter hatchmark gen:schema",
    "test:workerd": "node scripts/workerd-smoke.ts",
    "test:update-goldens": "HATCHMARK_UPDATE_GOLDENS=1 vitest run packages/hatchmark/test/render/golden.test.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^22.19.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
