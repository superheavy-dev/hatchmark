{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of the JSON Schema for this file, for editor completion."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "period": {
      "$ref": "#/$defs/Period"
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DashboardFilter"
      }
    },
    "blocks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Block"
      }
    }
  },
  "required": [
    "title",
    "blocks"
  ],
  "additionalProperties": false,
  "title": "Hatchmark dashboard (dashboards/<name>.json)",
  "$defs": {
    "Period": {
      "type": "object",
      "properties": {
        "asOf": {
          "anyOf": [
            {
              "type": "string",
              "const": "latest_data"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          ],
          "description": "\"latest_data\" (the last date in the data) or a fixed YYYY-MM-DD, so builds are reproducible."
        },
        "range": {
          "$ref": "#/$defs/PeriodRange"
        },
        "compare": {
          "$ref": "#/$defs/Comparison"
        }
      },
      "required": [
        "asOf",
        "range",
        "compare"
      ],
      "additionalProperties": false,
      "description": "Defaults to {\"asOf\": \"latest_data\", \"range\": \"last_12_months\", \"compare\": \"previous_period\"}."
    },
    "PeriodRange": {
      "type": "string",
      "enum": [
        "last_7_days",
        "last_30_days",
        "last_90_days",
        "last_12_months",
        "month_to_date",
        "quarter_to_date",
        "year_to_date",
        "last_complete_month",
        "last_complete_quarter",
        "last_complete_year",
        "all_time"
      ]
    },
    "Comparison": {
      "type": "string",
      "enum": [
        "previous_period",
        "previous_year",
        "none"
      ],
      "description": "previous_period: the previous calendar unit for calendar ranges (October vs September; to-date ranges compare the same elapsed span), or the same length just before for rolling ranges (last N days, last 12 months). previous_year: the same span one year earlier. none: no comparison."
    },
    "DashboardFilter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "select"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "label": {
              "type": "string"
            },
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "Filters every block whose metric table has this column."
            },
            "multiple": {
              "type": "boolean"
            },
            "default": {
              "description": "Default: no filter (all).",
              "anyOf": [
                {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                }
              ]
            }
          },
          "required": [
            "type",
            "id",
            "column"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "period"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "label": {
              "type": "string"
            },
            "options": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/PeriodRange"
              }
            },
            "default": {
              "$ref": "#/$defs/PeriodRange"
            }
          },
          "required": [
            "type",
            "id",
            "options",
            "default"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Block": {
      "oneOf": [
        {
          "$ref": "#/$defs/KpiBlock"
        },
        {
          "$ref": "#/$defs/LineBlock"
        },
        {
          "$ref": "#/$defs/AreaBlock"
        },
        {
          "$ref": "#/$defs/BarBlock"
        },
        {
          "$ref": "#/$defs/BarListBlock"
        },
        {
          "$ref": "#/$defs/TableBlock"
        },
        {
          "$ref": "#/$defs/TextBlock"
        }
      ]
    },
    "KpiBlock": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable block id. Defaults to <type>_<index>; set it to keep links and caches across reorders.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "description": "Card title; state the finding.",
          "type": "string"
        },
        "span": {
          "description": "Width in a 12-column grid.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "type": {
          "type": "string",
          "const": "kpi"
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A metric name, the file name under metrics/."
        },
        "compare": {
          "description": "Defaults to the dashboard period's compare.",
          "$ref": "#/$defs/Comparison"
        },
        "sparkline": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "metric"
      ],
      "additionalProperties": false
    },
    "LineBlock": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable block id. Defaults to <type>_<index>; set it to keep links and caches across reorders.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "description": "Card title; state the finding.",
          "type": "string"
        },
        "span": {
          "description": "Width in a 12-column grid.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "metrics": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A metric name, the file name under metrics/."
          }
        },
        "grain": {
          "$ref": "#/$defs/TimeGrain"
        },
        "split": {
          "description": "Column that splits one metric into series.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "line"
        }
      },
      "required": [
        "metrics",
        "grain",
        "type"
      ],
      "additionalProperties": false
    },
    "TimeGrain": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month",
        "quarter",
        "year"
      ]
    },
    "AreaBlock": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable block id. Defaults to <type>_<index>; set it to keep links and caches across reorders.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "description": "Card title; state the finding.",
          "type": "string"
        },
        "span": {
          "description": "Width in a 12-column grid.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "metrics": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A metric name, the file name under metrics/."
          }
        },
        "grain": {
          "$ref": "#/$defs/TimeGrain"
        },
        "split": {
          "description": "Column that splits one metric into series.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "const": "area"
        },
        "stack": {
          "type": "boolean"
        }
      },
      "required": [
        "metrics",
        "grain",
        "type"
      ],
      "additionalProperties": false
    },
    "BarBlock": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable block id. Defaults to <type>_<index>; set it to keep links and caches across reorders.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "description": "Card title; state the finding.",
          "type": "string"
        },
        "span": {
          "description": "Width in a 12-column grid.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "type": {
          "type": "string",
          "const": "bar"
        },
        "metrics": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A metric name, the file name under metrics/."
          }
        },
        "by": {
          "description": "Category column on the axis. Use either by or grain.",
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "description": "Time buckets on the axis. Use either by or grain.",
          "$ref": "#/$defs/TimeGrain"
        },
        "split": {
          "type": "string",
          "minLength": 1,
          "description": "A column name in the source data."
        },
        "stack": {
          "type": "boolean"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal"
          ]
        },
        "sort": {
          "$ref": "#/$defs/Sort"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "type",
        "metrics"
      ],
      "additionalProperties": false
    },
    "Sort": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "A metric name or a column in by."
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "required": [
        "by",
        "order"
      ],
      "additionalProperties": false
    },
    "BarListBlock": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable block id. Defaults to <type>_<index>; set it to keep links and caches across reorders.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "description": "Card title; state the finding.",
          "type": "string"
        },
        "span": {
          "description": "Width in a 12-column grid.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "type": {
          "type": "string",
          "const": "bar_list"
        },
        "metric": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A metric name, the file name under metrics/."
        },
        "by": {
          "type": "string",
          "minLength": 1,
          "description": "A column name in the source data."
        },
        "limit": {
          "description": "Rows shown. Default 10.",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "required": [
        "type",
        "metric",
        "by"
      ],
      "additionalProperties": false
    },
    "TableBlock": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable block id. Defaults to <type>_<index>; set it to keep links and caches across reorders.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "description": "Card title; state the finding.",
          "type": "string"
        },
        "span": {
          "description": "Width in a 12-column grid.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "type": {
          "type": "string",
          "const": "table"
        },
        "by": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "A column name in the source data."
          },
          "description": "Grouping columns, outermost first."
        },
        "metrics": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A metric name, the file name under metrics/."
          }
        },
        "totals": {
          "description": "Total row, recomputed from rows (not summed). Default true.",
          "type": "boolean"
        },
        "percentOfTotal": {
          "description": "Metrics that also show their share of the total. Additive metrics only.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "A metric name, the file name under metrics/."
          }
        },
        "sort": {
          "$ref": "#/$defs/Sort"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "type",
        "by",
        "metrics"
      ],
      "additionalProperties": false
    },
    "TextBlock": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Stable block id. Defaults to <type>_<index>; set it to keep links and caches across reorders.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "title": {
          "description": "Card title; state the finding.",
          "type": "string"
        },
        "span": {
          "description": "Width in a 12-column grid.",
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "type": {
          "type": "string",
          "const": "text"
        },
        "markdown": {
          "type": "string",
          "description": "Markdown. {{metric}} inserts the current value; {{metric.previous}}, {{metric.change}} and {{metric.change_pct}} insert the comparison."
        }
      },
      "required": [
        "type",
        "markdown"
      ],
      "additionalProperties": false
    }
  }
}
