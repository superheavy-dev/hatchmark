{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of the JSON Schema for this file, for editor completion."
    },
    "version": {
      "type": "number",
      "const": 1,
      "description": "Spec format version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Project name, shown in page titles."
    },
    "dataDir": {
      "type": "string",
      "minLength": 1,
      "description": "Directory holding data files."
    },
    "metricsDir": {
      "type": "string",
      "minLength": 1,
      "description": "Directory holding metrics/<name>.json files."
    },
    "dashboardsDir": {
      "type": "string",
      "minLength": 1,
      "description": "Directory holding dashboards/<name>.json files."
    },
    "outDir": {
      "type": "string",
      "minLength": 1,
      "description": "Build output directory."
    },
    "locale": {
      "type": "string",
      "description": "Locale for number and date formatting."
    },
    "currency": {
      "type": "string",
      "description": "Default currency for currency-formatted metrics."
    },
    "timezone": {
      "type": "string",
      "description": "Time zone that dates are bucketed in."
    },
    "weekStart": {
      "type": "string",
      "enum": [
        "monday",
        "sunday"
      ],
      "description": "First day of a week bucket."
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Theme id."
    },
    "telemetry": {
      "type": "boolean",
      "description": "Send anonymous usage data. Off unless set true."
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      },
      "description": "Tables by name. Metrics refer to these names in their table field."
    }
  },
  "required": [
    "version",
    "name",
    "dataDir",
    "metricsDir",
    "dashboardsDir",
    "outDir",
    "locale",
    "currency",
    "timezone",
    "weekStart",
    "theme",
    "telemetry",
    "sources"
  ],
  "additionalProperties": false,
  "title": "Hatchmark project config (hatchmark.json)",
  "$defs": {
    "Source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "csv"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "delimiter": {
              "description": "Field delimiter. Default \",\".",
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            },
            "header": {
              "description": "Whether the first row holds column names. Default true.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "parquet"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "description": "An array of objects, or one object per line. Default \"array\".",
              "type": "string",
              "enum": [
                "array",
                "ndjson"
              ]
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A table read from a file in the project."
    }
  }
}
