{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of the JSON Schema for this file, for editor completion."
    },
    "version": {
      "type": "number",
      "const": 1,
      "description": "Spec format version."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Project name, shown in page titles."
    },
    "dataDir": {
      "type": "string",
      "minLength": 1,
      "description": "Directory holding data files."
    },
    "metricsDir": {
      "type": "string",
      "minLength": 1,
      "description": "Directory holding metrics/<name>.json files."
    },
    "dashboardsDir": {
      "type": "string",
      "minLength": 1,
      "description": "Directory holding dashboards/<name>.json files."
    },
    "segmentsDir": {
      "description": "Directory holding segments/<name>.json files. Optional until a project has segments; default \"segments\".",
      "type": "string",
      "minLength": 1
    },
    "outDir": {
      "type": "string",
      "minLength": 1,
      "description": "Build output directory."
    },
    "locale": {
      "type": "string",
      "description": "Locale for number and date formatting."
    },
    "currency": {
      "type": "string",
      "description": "Default currency for currency-formatted metrics."
    },
    "timezone": {
      "type": "string",
      "description": "Time zone that dates are bucketed in."
    },
    "weekStart": {
      "type": "string",
      "enum": [
        "monday",
        "sunday"
      ],
      "description": "First day of a week bucket."
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Theme id."
    },
    "telemetry": {
      "type": "boolean",
      "description": "Send anonymous usage data. Off unless set true."
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Source"
      },
      "description": "Tables by name. Metrics refer to these names in their table field."
    }
  },
  "required": [
    "version",
    "name",
    "dataDir",
    "metricsDir",
    "dashboardsDir",
    "outDir",
    "locale",
    "currency",
    "timezone",
    "weekStart",
    "theme",
    "telemetry",
    "sources"
  ],
  "additionalProperties": false,
  "title": "Hatchmark project config (hatchmark.json)",
  "$defs": {
    "Source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "csv"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "snapshot": {
              "description": "The source is a full snapshot per value of this date column; metrics on it must not sum over time.",
              "type": "string",
              "minLength": 1
            },
            "freshness": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Use the latest value of this column instead."
                    }
                  },
                  "required": [
                    "column"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "lag": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "days": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 366
                            }
                          },
                          "required": [
                            "days"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "hours": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 8784
                            }
                          },
                          "required": [
                            "hours"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "lag"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "through": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "as_of"
                        },
                        {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        }
                      ],
                      "description": "\"as_of\": complete whenever the build runs; a date: complete through it."
                    }
                  },
                  "required": [
                    "through"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "How complete the source is. Default: through its latest timestamp, or through the whole latest date of a date column."
            },
            "timezone": {
              "description": "Time zone of timestamps without an offset. Default UTC.",
              "type": "string"
            },
            "delimiter": {
              "description": "Field delimiter. Default \",\".",
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            },
            "header": {
              "description": "Whether the first row holds column names. Default true.",
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "parquet"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "snapshot": {
              "description": "The source is a full snapshot per value of this date column; metrics on it must not sum over time.",
              "type": "string",
              "minLength": 1
            },
            "freshness": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Use the latest value of this column instead."
                    }
                  },
                  "required": [
                    "column"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "lag": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "days": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 366
                            }
                          },
                          "required": [
                            "days"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "hours": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 8784
                            }
                          },
                          "required": [
                            "hours"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "lag"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "through": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "as_of"
                        },
                        {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        }
                      ],
                      "description": "\"as_of\": complete whenever the build runs; a date: complete through it."
                    }
                  },
                  "required": [
                    "through"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "How complete the source is. Default: through its latest timestamp, or through the whole latest date of a date column."
            },
            "timezone": {
              "description": "Time zone of timestamps without an offset. Default UTC.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "json"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "snapshot": {
              "description": "The source is a full snapshot per value of this date column; metrics on it must not sum over time.",
              "type": "string",
              "minLength": 1
            },
            "freshness": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Use the latest value of this column instead."
                    }
                  },
                  "required": [
                    "column"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "lag": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "days": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 366
                            }
                          },
                          "required": [
                            "days"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "hours": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 8784
                            }
                          },
                          "required": [
                            "hours"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "lag"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "through": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "as_of"
                        },
                        {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        }
                      ],
                      "description": "\"as_of\": complete whenever the build runs; a date: complete through it."
                    }
                  },
                  "required": [
                    "through"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "How complete the source is. Default: through its latest timestamp, or through the whole latest date of a date column."
            },
            "timezone": {
              "description": "Time zone of timestamps without an offset. Default UTC.",
              "type": "string"
            },
            "format": {
              "description": "An array of objects, or one object per line. Default \"array\".",
              "type": "string",
              "enum": [
                "array",
                "ndjson"
              ]
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "lookup"
            },
            "from": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "The base file source."
            },
            "lookups": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$",
                    "description": "A file source to join onto the base table."
                  },
                  "key": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "description": "A column name in the source data."
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "description": "A column name in the source data."
                    },
                    "description": "Base column to lookup column, such as {\"subscription\": \"id\"}."
                  },
                  "asof": {
                    "description": "Pick the latest lookup row on or before an instant among rows with an equal key.",
                    "type": "object",
                    "properties": {
                      "column": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The lookup table's date or timestamp column."
                      },
                      "at": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A base time column, or \"$evaluation\" for the instant a point-in-time metric is read at."
                      }
                    },
                    "required": [
                      "column",
                      "at"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "table",
                  "key"
                ],
                "additionalProperties": false,
                "description": "A many-to-one join: each base row gets at most one lookup row, so sums never multiply."
              }
            },
            "freshness": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "column": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Use the latest value of this column instead."
                    }
                  },
                  "required": [
                    "column"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "lag": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "days": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 366
                            }
                          },
                          "required": [
                            "days"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "hours": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 8784
                            }
                          },
                          "required": [
                            "hours"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "lag"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "through": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "as_of"
                        },
                        {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        }
                      ],
                      "description": "\"as_of\": complete whenever the build runs; a date: complete through it."
                    }
                  },
                  "required": [
                    "through"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "How complete the source is. Default: through its latest timestamp, or through the whole latest date of a date column."
            }
          },
          "required": [
            "type",
            "from",
            "lookups"
          ],
          "additionalProperties": false,
          "description": "The base source with other sources joined on; their columns read as <table>.<column>."
        }
      ],
      "description": "A table read from a file in the project, or a lookup over others."
    }
  }
}
