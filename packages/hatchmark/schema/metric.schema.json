          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "time": {
          "description": "Date or timestamp column that places rows in time. Needed for time series and period comparison.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "format",
        "better",
        "type",
        "table",
        "sql",
        "additive"
      ],
      "additionalProperties": false
    },
    "FormulaMetric": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
