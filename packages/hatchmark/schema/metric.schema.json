    "PerEntityMetric": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path or URL of the JSON Schema for this file, for editor completion."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human name, such as Net revenue."
        },
        "description": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "better": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "description": "Which direction of change is good; colours the KPI delta."
        },
        "targets": {
          "description": "Goals for this metric.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "tests": {
          "description": "Pinned values that check verifies against the data.",
          "type": "array",
          "items": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "at"
                    ]
                  },
                  {
                    "required": [
                      "window"
                    ]
                  }
                ]
              },
              {
                "if": {
                  "required": [
                    "by"
                  ]
                },
                "then": {
                  "properties": {
                    "expect": {
                      "type": "object"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "expect": {
                      "type": "number"
                    }
                  }
                }
              }
            ],
            "$ref": "#/$defs/MetricTest"
          }
        },
        "type": {
