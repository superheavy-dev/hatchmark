          }
        },
        "tests": {
          "description": "Pinned values that check verifies against the data.",
          "type": "array",
          "items": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "at"
                    ]
                  },
                  {
                    "required": [
                      "window"
                    ]
                  }
                ]
              },
              {
                "if": {
                  "required": [
                    "by"
                  ]
                },
                "then": {
                  "properties": {
                    "expect": {
                      "type": "object"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "expect": {
                      "type": "number"
                    }
                  }
                }
              }
            ],
