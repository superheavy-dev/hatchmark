          }
        },
        "type": {
          "type": "string",
          "const": "formula"
        },
        "expr": {
          "type": "string",
          "minLength": 1,
          "description": "Arithmetic over metric names: + - * /, parentheses, numbers, coalesce, min, max, abs. Such as subscription_arr + credit_run_rate * 0.6."
