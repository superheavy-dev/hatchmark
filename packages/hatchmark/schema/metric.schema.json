{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/AggregateMetric"
    },
    {
      "$ref": "#/$defs/RatioMetric"
    },
    {
      "$ref": "#/$defs/SqlMetric"
    }
  ],
  "title": "Hatchmark metric (metrics/<name>.json)",
  "$defs": {
    "AggregateMetric": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path or URL of the JSON Schema for this file, for editor completion."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human name, such as Net revenue."
        },
        "description": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "better": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "description": "Which direction of change is good; colours the KPI delta."
        },
        "type": {
          "type": "string",
          "const": "aggregate"
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A source name from hatchmark.json."
        },
        "aggregate": {
          "type": "string",
          "enum": [
            "sum",
            "count",
            "count_distinct",
            "avg",
            "min",
            "max",
            "median"
          ]
        },
        "column": {
          "description": "Column to aggregate. Required except for count, where it counts non-null values; without it, count counts rows.",
          "type": "string",
          "minLength": 1
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "time": {
          "description": "Date or timestamp column that places rows in time. Needed for time series and period comparison.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "format",
        "better",
        "type",
        "table",
        "aggregate"
      ],
      "additionalProperties": false
    },
    "Format": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "compact": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "currency"
            },
            "currency": {
              "description": "Overrides the project currency.",
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "compact": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "percent"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "The value is a fraction: 0.124 shows as 12.4%."
        }
      ],
      "description": "How values of this metric are shown."
    },
    "Filter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "column",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "enum": [
                "in",
                "not_in"
              ]
            },
            "values": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "required": [
            "column",
            "op",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "enum": [
                "is_null",
                "not_null"
              ]
            }
          },
          "required": [
            "column",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "const": "between"
            },
            "from": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "to": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "column",
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A row filter. between is inclusive at both ends. A date (YYYY-MM-DD) compared with a timestamp column compares the row's calendar date in the project time zone, so eq matches the whole day and between includes all of its last day. neq and not_in keep rows whose column is null; the other operators never match null."
    },
    "RatioMetric": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path or URL of the JSON Schema for this file, for editor completion."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human name, such as Net revenue."
        },
        "description": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "better": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "description": "Which direction of change is good; colours the KPI delta."
        },
        "type": {
          "type": "string",
          "const": "ratio"
        },
        "numerator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Metric name."
        },
        "denominator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Metric name."
        }
      },
      "required": [
        "label",
        "format",
        "better",
        "type",
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "SqlMetric": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path or URL of the JSON Schema for this file, for editor completion."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human name, such as Net revenue."
        },
        "description": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "better": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "description": "Which direction of change is good; colours the KPI delta."
        },
        "type": {
          "type": "string",
          "const": "sql"
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "description": "Escape hatch: one SQL aggregate expression over the table, such as sum(amount) - sum(refund)."
        },
        "additive": {
          "type": "boolean",
          "description": "True only if summing the metric over groups gives the metric over all rows."
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "time": {
          "description": "Date or timestamp column that places rows in time. Needed for time series and period comparison.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "format",
        "better",
        "type",
        "table",
        "sql",
        "additive"
      ],
      "additionalProperties": false
    }
  }
}
