{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/AggregateMetric"
    },
    {
      "$ref": "#/$defs/RatioMetric"
    },
    {
      "$ref": "#/$defs/SqlMetric"
    },
    {
      "$ref": "#/$defs/FormulaMetric"
    },
    {
      "$ref": "#/$defs/PerEntityMetric"
    }
  ],
  "title": "Hatchmark metric (metrics/<name>.json)",
  "$defs": {
    "AggregateMetric": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path or URL of the JSON Schema for this file, for editor completion."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human name, such as Net revenue."
        },
        "description": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "better": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "description": "Which direction of change is good; colours the KPI delta."
        },
        "targets": {
          "description": "Goals for this metric.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "tests": {
          "description": "Pinned values that check verifies against the data.",
          "type": "array",
          "items": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "at"
                    ]
                  },
                  {
                    "required": [
                      "window"
                    ]
                  }
                ]
              },
              {
                "if": {
                  "required": [
                    "by"
                  ]
                },
                "then": {
                  "properties": {
                    "expect": {
                      "type": "object"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "expect": {
                      "type": "number"
                    }
                  }
                }
              }
            ],
            "$ref": "#/$defs/MetricTest"
          }
        },
        "type": {
          "type": "string",
          "const": "aggregate"
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A source name from hatchmark.json."
        },
        "aggregate": {
          "type": "string",
          "enum": [
            "sum",
            "count",
            "count_distinct",
            "avg",
            "min",
            "max",
            "median"
          ]
        },
        "column": {
          "description": "Column to aggregate. Required except for count, where it counts non-null values; without it, count counts rows.",
          "type": "string",
          "minLength": 1
        },
        "value": {
          "description": "Row expression to aggregate instead of a column, such as price * quantity.",
          "type": "string",
          "minLength": 1
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "segments": {
          "description": "Segments always applied: names of files under segments/.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "time": {
          "description": "Date or timestamp column that places rows in time. Needed for time series and period comparison.",
          "type": "string",
          "minLength": 1
        },
        "over_time": {
          "description": "sum (default) adds rows over a bucket. last, first, avg, min, max make the metric point-in-time: read a snapshot, or each entity's latest row when entity is set.",
          "type": "string",
          "enum": [
            "sum",
            "last",
            "first",
            "avg",
            "min",
            "max"
          ]
        },
        "entity": {
          "description": "With over_time last or first: the key whose state each row describes; its latest row carries forward.",
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1,
              "description": "Row expression: the instant the row starts counting."
            },
            "to": {
              "type": "string",
              "minLength": 1,
              "description": "Row expression: the instant it stops counting; null means it never stops."
            },
            "ends": {
              "description": "Whether a row whose interval ends exactly at a bucket end still counts in that bucket. Default inclusive.",
              "type": "string",
              "enum": [
                "inclusive",
                "exclusive"
              ]
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false,
          "description": "Makes the metric point-in-time: a row counts at every instant in [from, to). Replaces time."
        },
        "trailing": {
          "description": "Makes the metric point-in-time: at each instant, aggregate the rows of this length before it.",
          "$ref": "#/$defs/Duration"
        },
        "scale": {
          "type": "number",
          "description": "Constant multiplier applied after aggregation, such as 0.01 or 12.",
          "not": {
            "const": 0
          }
        }
      },
      "required": [
        "label",
        "format",
        "better",
        "type",
        "table",
        "aggregate"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "column",
              "value"
            ]
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "aggregate": {
                  "const": "count"
                }
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "column"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "required": [
              "time",
              "active"
            ]
          }
        },
        {
          "if": {
            "required": [
              "active"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "over_time"
                  ]
                },
                {
                  "required": [
                    "trailing"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "over_time"
                ]
              },
              {
                "required": [
                  "trailing"
                ]
              }
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "time"
                ]
              },
              {
                "required": [
                  "active"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "trailing",
              "over_time"
            ]
          },
          "then": {
            "properties": {
              "over_time": {
                "const": "sum"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "entity"
            ]
          },
          "then": {
            "required": [
              "over_time"
            ],
            "properties": {
              "over_time": {
                "enum": [
                  "last",
                  "first"
                ]
              }
            }
          }
        }
      ]
    },
    "Format": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "compact": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "currency"
            },
            "currency": {
              "description": "Overrides the project currency.",
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "compact": {
              "type": "boolean"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "percent"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "The value is a fraction: 0.124 shows as 12.4%."
        }
      ],
      "description": "How values of this metric are shown."
    },
    "Target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "grain": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month",
            "quarter",
            "year"
          ],
          "description": "The grain the target values are stated at; each key or date is a bucket start."
        },
        "values": {
          "description": "Inline values by bucket start date, such as {\"2027-01-01\": 9000000}.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "table": {
          "description": "A source holding the target values.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "date": {
          "description": "Column with each bucket's start date.",
          "type": "string",
          "minLength": 1
        },
        "value": {
          "description": "Column with the target value.",
          "type": "string",
          "minLength": 1
        },
        "path": {
          "description": "Point-in-time targets only: how the target moves between values. Default linear.",
          "type": "string",
          "enum": [
            "linear",
            "compound"
          ]
        },
        "prorate": {
          "description": "Flow targets only: at a finer grain, split by days (default) or hide the target.",
          "type": "string",
          "enum": [
            "days",
            "none"
          ]
        },
        "segments": {
          "description": "Segments the target was set for; it hides when other segments are toggled.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "id",
        "grain"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "values"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "table"
                ]
              },
              {
                "required": [
                  "date"
                ]
              },
              {
                "required": [
                  "value"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "table",
            "date",
            "value"
          ],
          "not": {
            "required": [
              "values"
            ]
          }
        }
      ]
    },
    "Filter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "column",
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "enum": [
                "in",
                "not_in"
              ]
            },
            "values": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "required": [
            "column",
            "op",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "enum": [
                "is_null",
                "not_null"
              ]
            }
          },
          "required": [
            "column",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "const": "between"
            },
            "from": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "to": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "column",
            "op",
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "column": {
              "type": "string",
              "minLength": 1,
              "description": "A column name in the source data."
            },
            "op": {
              "type": "string",
              "enum": [
                "in_table",
                "not_in_table"
              ]
            },
            "table": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "A source name from hatchmark.json."
            },
            "key": {
              "type": "string",
              "minLength": 1,
              "description": "The column of that source to match against."
            }
          },
          "required": [
            "column",
            "op",
            "table",
            "key"
          ],
          "additionalProperties": false,
          "description": "Keeps rows whose column value appears (in_table) or does not appear (not_in_table) in another source's key column. A null value passes not_in_table and fails in_table."
        }
      ],
      "description": "A row filter. between is inclusive at both ends. A date (YYYY-MM-DD) compared with a timestamp column compares the row's calendar date in the project time zone, so eq matches the whole day and between includes all of its last day. neq and not_in keep rows whose column is null; the other operators never match null."
    },
    "MetricTest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "description": "Point-in-time metrics: the value at the end of this local date.",
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "window": {
          "description": "Flow metrics: an inclusive pair of local dates.",
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "where": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "by": {
          "description": "Check a breakdown; expect is then an object.",
          "type": "string",
          "minLength": 1
        },
        "expect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        },
        "tolerance": {
          "description": "Absolute, in display units. Default: equal after rounding to 6 decimals.",
          "type": "number",
          "minimum": 0
        },
        "data": {
          "description": "Swap sources for fixture files, by source name.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "expect"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "required": [
                "at"
              ]
            },
            {
              "required": [
                "window"
              ]
            }
          ]
        },
        {
          "if": {
            "required": [
              "by"
            ]
          },
          "then": {
            "properties": {
              "expect": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "expect": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "Duration": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3660
            }
          },
          "required": [
            "days"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "months": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            }
          },
          "required": [
            "months"
          ],
          "additionalProperties": false
        }
      ],
      "description": "A length of time, such as {\"days\": 30} or {\"months\": 12}."
    },
    "RatioMetric": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path or URL of the JSON Schema for this file, for editor completion."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human name, such as Net revenue."
        },
        "description": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "better": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "description": "Which direction of change is good; colours the KPI delta."
        },
        "targets": {
          "description": "Goals for this metric.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "tests": {
          "description": "Pinned values that check verifies against the data.",
          "type": "array",
          "items": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "at"
                    ]
                  },
                  {
                    "required": [
                      "window"
                    ]
                  }
                ]
              },
              {
                "if": {
                  "required": [
                    "by"
                  ]
                },
                "then": {
                  "properties": {
                    "expect": {
                      "type": "object"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "expect": {
                      "type": "number"
                    }
                  }
                }
              }
            ],
            "$ref": "#/$defs/MetricTest"
          }
        },
        "type": {
          "type": "string",
          "const": "ratio"
        },
        "numerator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Metric name."
        },
        "denominator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Metric name."
        }
      },
      "required": [
        "label",
        "format",
        "better",
        "type",
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "SqlMetric": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string",
          "description": "Path or URL of the JSON Schema for this file, for editor completion."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human name, such as Net revenue."
        },
        "description": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "better": {
          "type": "string",
          "enum": [
            "up",
            "down",
            "neutral"
          ],
          "description": "Which direction of change is good; colours the KPI delta."
        },
        "targets": {
          "description": "Goals for this metric.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Target"
          }
        },
        "tests": {
          "description": "Pinned values that check verifies against the data.",
          "type": "array",
          "items": {
            "allOf": [
              {
                "oneOf": [
                  {
                    "required": [
                      "at"
                    ]
                  },
                  {
                    "required": [
                      "window"
                    ]
                  }
                ]
              },
              {
                "if": {
                  "required": [
                    "by"
                  ]
                },
                "then": {
                  "properties": {
                    "expect": {
                      "type": "object"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "expect": {
                      "type": "number"
                    }
                  }
                }
              }
            ],
            "$ref": "#/$defs/MetricTest"
          }
        },
        "type": {
          "type": "string",
          "const": "sql"
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "description": "Escape hatch: one SQL aggregate expression over the table, such as sum(amount) - sum(refund)."
        },
        "additive": {
          "type": "boolean",
          "description": "True only if summing the metric over groups gives the metric over all rows."
        },
        "filters": {
          "type": "array",
          "items": {
