{
  "name": "hatchmark",
  "version": "0.0.0",
  "description": "Agent-first dashboard renderer: short JSON specs in, correct and consistent dashboards out.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superheavy-dev/hatchmark.git",
    "directory": "packages/hatchmark"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "schema",
    "assets",
    "runtime/dev-client.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p runtime/tsconfig.json",
    "gen:schema": "pnpm build && node scripts/write-schemas.ts",
    "gen:text-metrics": "node scripts/gen-text-metrics.ts",
    "prepack": "node -e \"for (const f of ['LICENSE', 'NOTICE']) require('fs').copyFileSync('../../' + f, f)\""
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.1-r.1",
    "@vercel/detect-agent": "^1.2.7",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "vite": "~8.3.8",
    "zod": "^4.6.7"
  },
  "bin": {
    "hatchmark": "./dist/cli/bin.js"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/fontkit": "^2.0.9",
    "ajv": "^8.20.0",
    "fontkit": "^3.0.0",
    "playwright": "^1.65.1"
  }
}
