{
  "name": "hatchmark",
  "version": "0.0.0",
  "description": "Agent-first dashboard renderer: short JSON specs in, correct and consistent dashboards out.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superheavy-dev/hatchmark.git",
    "directory": "packages/hatchmark"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "schema",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:schema": "pnpm build && node scripts/write-schemas.ts",
    "prepack": "node -e \"for (const f of ['LICENSE', 'NOTICE']) require('fs').copyFileSync('../../' + f, f)\""
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.1-r.1",
    "@vercel/detect-agent": "^1.2.7",
    "zod": "^4.6.7"
  },
  "bin": {
    "hatchmark": "./dist/cli/bin.js"
  }
}
