      "accentContrast": "#ffffff",
      "good": "#0a7ca6",
      "bad": "#a63d02",
      "context": "#d0d0d0",
      "land": "#ececec",
      "landBorder": "#ffffff",
      "focus": "#171717"
    },
    "dark": {
      "page": "#111111",
      "card": "#191919",
      "cardAlt": "#1e1e1e",
      "border": "#2b2b2b",
      "borderStrong": "#3a3a3a",
