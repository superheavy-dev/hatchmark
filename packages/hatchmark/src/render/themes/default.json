{
  "$schema": "hatchmark-tokens/0.2",
  "id": "default",
  "name": "Default",
  "version": "1.1.0",
  "status": "final",
  "finalized": "2026-11-27: good/bad variant A (cerulean / vermilion); brand colours are kept and warned about, never replaced",
  "changelog": {
    "1.1.0": "Categorical palette adapted from the FT's g-chartcolour 0.8.26 (BSD-3-Clause), with separate stroke and fill sets. Strokes (lines, points, line keys) use data.<mode>.categorical, built from FT categorical_line; fills (bars, areas, pie and donut slices, square keys) use data.<mode>.categoricalFill, built from FT categorical_bar and re-ordered so slot n matches the stroke hue of slot n. Light values keep FT's hues, with lightness adjusted where a slot missed 3:1 contrast or the colour-vision separation bar; the dark set is derived. Context grey unchanged.",
    "1.0.1": "Names are never middle-truncated (legends, keys and direct labels reflow, bar categories wrap), KPI sparklines get the line tooltip, KPI note to sparkline gap 8 to 12 px."
  },
  "license": "Apache-2.0",
  "origin": "Designed for Hatchmark. Categorical colours are adapted from the FT's g-chartcolour 0.8.26 (BSD-3-Clause).",
  "layers": {
    "theme": "fixed by the theme (this file)",
    "brand": "overridable through brand-layer.schema.json; see brandable flags"
  },
  "font": {
    "sans": {
      "family": "IBM Plex Sans",
      "fallback": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "weights": [
        400,
        500,
        600
      ],
      "license": "SIL OFL 1.1",
      "features": {
        "numbers": "tnum",
        "zero": false
      }
    }
  },
  "type": {
    "caption": {
      "size": 12,
      "lineHeight": 16,
      "weight": 400,
      "use": "ticks, axis labels, legends, captions, table headers, annotation notes"
    },
    "body": {
      "size": 13,
      "lineHeight": 18,
      "weight": 400,
      "use": "table cells, bar list, tooltip rows, card subtitles"
    },
    "title": {
      "size": 14,
      "lineHeight": 20,
      "weight": 500,
      "use": "card titles (state the finding)"
    },
    "page": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600,
      "tracking": "-0.01em",
      "use": "dashboard title"
    },
    "kpi": {
      "size": 28,
      "lineHeight": 32,
      "weight": 400,
      "tracking": "-0.02em",
      "use": "KPI values"
    },
    "minimum": 12,
    "numbers": "tabular-nums everywhere",
    "truncation": "names are never cut in the middle. Series names (legend, key, direct labels, readout) reflow, and only a name wider than the whole card ends in an ellipsis; horizontal bar categories wrap to tableMaxLines in a column up to 40% of the chart; vertical bar ticks thin, then end in an ellipsis. The full name is always in the tooltip.",
    "tableMaxLines": 2
  },
