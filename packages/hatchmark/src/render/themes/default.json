{
  "$schema": "hatchmark-tokens/0.2",
  "id": "default",
  "name": "Default",
  "version": "1.0.1",
  "status": "final",
  "finalized": "2026-11-27 (HAT-8, approved by Gunwoo: good/bad variant A, brand rule warn-not-replace)",
  "changelog": {
    "1.0.1": "HAT-19: names are never middle-truncated (legends, keys and direct labels reflow, bar categories wrap), KPI sparklines get the line tooltip, KPI note to sparkline gap 8 to 12 px."
  },
  "license": "Apache-2.0",
  "origin": "Exported from Paper file 01M8DTB9YYV2B57MQKB6B0M0G2 (Paper tokens are the source of truth for values; rules and metadata carried from the HAT-8 builder).",
  "layers": {
    "theme": "fixed by the theme (this file)",
    "brand": "overridable through brand-layer.schema.json; see brandable flags"
  },
  "font": {
    "sans": {
      "family": "IBM Plex Sans",
      "fallback": "system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "weights": [
        400,
        500,
        600
      ],
      "license": "SIL OFL 1.1",
      "features": {
        "numbers": "tnum",
        "zero": false
      }
    }
  },
  "type": {
    "caption": {
      "size": 12,
      "lineHeight": 16,
      "weight": 400,
      "use": "ticks, axis labels, legends, captions, table headers, annotation notes"
    },
    "body": {
      "size": 13,
      "lineHeight": 18,
      "weight": 400,
      "use": "table cells, bar list, tooltip rows, card subtitles"
    },
    "title": {
      "size": 14,
      "lineHeight": 20,
      "weight": 500,
      "use": "card titles (state the finding)"
    },
    "page": {
      "size": 20,
      "lineHeight": 28,
      "weight": 600,
      "tracking": "-0.01em",
      "use": "dashboard title"
    },
    "kpi": {
      "size": 28,
      "lineHeight": 32,
      "weight": 400,
      "tracking": "-0.02em",
      "use": "KPI values"
    },
    "minimum": 12,
    "numbers": "tabular-nums everywhere",
    "truncation": "names are never cut in the middle. Series names (legend, key, direct labels, readout) reflow, and only a name wider than the whole card ends in an ellipsis; horizontal bar categories wrap to tableMaxLines in a column up to 40% of the chart; vertical bar ticks thin, then end in an ellipsis. The full name is always in the tooltip.",
    "tableMaxLines": 2
  },
  "color": {
    "light": {
      "page": "#f5f5f5",
      "card": "#ffffff",
      "cardAlt": "#fafafa",
      "border": "#e5e5e5",
      "borderStrong": "#d4d4d4",
      "grid": "#ebebeb",
      "baseline": "#c7c7c7",
      "text": "#171717",
      "textMuted": "#525252",
