    "rules": {
      "directLabelsUpTo": 6,
      "moreThan6": "group into Other or small multiples (check error HM-C006)",
      "strokeAndFill": "categorical paints strokes: lines, points, line legend keys and series-coloured text. categoricalFill paints fills: bars, stacked and 100% segments, areas, pie and donut slices and square legend keys. Slot n is the same hue family in both sets, so a series keeps its colour across chart types.",
      "order": "fixed slot order c1..c8: categorical follows FT categorical_line order; categoricalFill takes, for each line slot, FT's categorical_bar colour of the nearest hue (bar indices 1,5,2,7,3,4,6,8). Series wrap after c8.",
      "highlightOne": "c1 for the highlighted item, context for the rest"
    },
    "attribution": "Categorical colours are adapted from the FT's g-chartcolour."
  },
  "density": {
    "default": "compact",
    "compact": {
      "tableRow": 30,
      "cardPadding": 16,
      "gap": 12,
      "page": 24,
      "kpiPadding": 16,
      "barRow": 28,
      "chartHeight": 280,
      "kpiSize": 28,
      "kpiLineHeight": 32,
      "historyRow": 26,
      "periodChartHeight": 150
    },
    "comfortable": {
      "tableRow": 36,
      "cardPadding": 20,
      "gap": 16,
      "page": 32,
      "kpiPadding": 20,
      "barRow": 34,
      "chartHeight": 320,
      "kpiSize": 36,
      "kpiLineHeight": 40,
      "historyRow": 30,
      "periodChartHeight": 170
    }
  },
  "radius": {
    "card": 6,
    "control": 4,
    "tooltip": 4,
    "bar": 1,
    "badge": 4
  },
  "card": {
    "group": {
      "use": "related cards share one container: 1px internal dividers in border colour, no gap, outer radius card",
      "mobile": "cells stack, divider on top"
    }
  },
  "border": {
    "width": 1,
    "shadows": "none on cards; one shadow on floating layers only (tooltip): 0 4px 12px rgba(0,0,0,.08) light, none in dark"
  },
  "chart": {
    "grid": {
      "horizontal": true,
      "vertical": false,
      "width": 1,
      "color": "grid",
      "baseline": "baseline at zero only"
    },
    "axis": {
      "lines": false,
      "ticks": false,
      "yLabels": "left, right-aligned, compact currency",
      "ySpacing": 48,
      "yTicks": [
        3,
        6
      ],
      "xLabels": "month starts, January and first label carry the year",
      "minLabelGap": 8,
      "tickPadding": 8
    },
    "line": {
      "width": 1.75,
      "curve": "linear",
      "area": "none (no gradient fills)",
      "dotRadius": 3.5,
      "dotRing": 2
    },
    "bar": {
      "radius": 1,
      "gapRatio": 0.25
    },
    "directLabels": {
      "show": "up to 6 series",
      "content": "name + last value",
      "minSpacing": 16,
      "maxWidth": "none: the full name and last value",
      "fallbackBelowPlotWidth": 320,
      "fallback": "coloured inline key above plot"
    },
    "annotations": {
      "style": "dotted rule + short note",
      "rule": "1px, dash 2 3, textSubtle",
      "note": "caption, textMuted",
      "band": "notes above plot, max 2 rows, flip left at right edge, else numbered markers listed below"
    },
    "tooltip": {
      "padding": "8px 10px",
      "radius": "tooltip",
      "swatch": "line 10x2",
      "header": "caption 500",
      "rows": "body tabular",
      "total": true,
      "mobile": "pinned readout row above the plot instead of a floating card"
    },
    "legend": {
      "default": "direct labels",
      "when": "maps and > 6 series only",
      "swatch": "line or square 8px",
      "names": "never truncated: the key drops to fewer columns or gives each label the width it needs"
    },
    "deltas": {
      "good": "good colour + ▲/▼ + sign",
      "bad": "bad colour + ▲/▼ + sign",
      "lowerIsBetter": "flip colour, say lower is better",
      "semantic": "good and bad are judgement colours: never used for series, ramps or the accent",
      "variant": "A",
      "variantName": "cerulean / vermilion"
    },
    "periodLegend": {
      "use": "charts that compare periods",
      "current": "solid c1 line swatch 12x2 + date range",
      "previous": "dashed (3 2) c1 at the same width + date range",
      "placement": "under the title, caption textMuted"
    },
    "kpiHistory": {
      "periods": 6,
      "row": "label, track bar, value",
      "current": "text colour, bar c1",
      "past": "textMuted, bar context",
      "delta": "on the headline figure only"
    },
    "empty": {
      "undefined": "— (em dash) in textSubtle with a one-line reason",
      "zero": "a real 0 in the normal format",
      "noData": "keep axes and baseline, no series, note in the plot centre: No <measure> in this period",
      "never": "NaN, Infinity, skeleton shimmer, fake placeholder data"
    },
    "partial": {
      "region": {
        "use": "line and area charts only: the partial bucket's slot, behind grid-level content and in front of the card",
        "extent": "last bucket: from the midpoint between the previous point and the partial point to the plot's right edge; clipped first bucket: from the plot's left edge to the midpoint after the first point",
        "background": {
          "light": "cardAlt",
          "dark": "cardAlt"
        },
        "pattern": {
          "kind": "hatch",
          "angle": 45,
          "spacing": 4,
          "strokeWidth": 1
        },
        "color": {
          "light": "textSubtle",
          "dark": "textSubtle"
        },
        "opacity": {
          "light": 0.28,
          "dark": 0.4
        }
      },
      "line": {
        "stroke": "series",
        "width": 1.75,
        "dash": null,
        "opacity": 1,
        "note": "the segment into the partial bucket stays solid; the region and the point carry the signal"
      },
      "point": {
        "style": "hollow",
        "radius": 3.5,
        "ring": 1.75,
        "fill": "card",
        "stroke": "series",
        "always": true,
        "note": "drawn on every partial point (last, and first under clip), not only on hover"
      },
      "area": {
        "base": {
          "fill": "series",
          "opacity": 0.14
        },
        "fill": {
          "opacity": 0
        },
        "pattern": {
          "kind": "hatch",
          "angle": 45,
          "spacing": 4,
          "strokeWidth": 1,
          "color": "series"
        },
        "patternOpacity": {
          "light": 0.55,
          "dark": 0.55
        },
        "stacked": "each band's partial slice is hatched in its own colour, no flat fill"
      },
      "bar": {
        "tint": {
          "fill": "series",
          "opacity": 0.1
        },
        "pattern": {
          "kind": "hatch",
          "angle": 45,
          "spacing": 4,
          "strokeWidth": 1,
          "color": "series"
        },
        "patternOpacity": {
          "light": 0.75,
          "dark": 0.75
        },
        "outline": {
          "stroke": "series",
          "width": 1,
          "inset": 0.5
        },
        "radius": 0,
        "stacked": "every stack part gets tint, hatch and outline in its own colour; parts under 6 px keep tint and outline and drop the hatch",
        "valueLabel": "if a value label is shown on the partial bar, use textMuted"
      },
      "swatch": {
        "use": "tooltip status line, tooltip series rows and the mobile readout when the bucket is partial",
        "size": 10,
        "tint": 0.1,
        "pattern": {
          "kind": "hatch",
          "angle": 45,
          "spacing": 3,
          "strokeWidth": 1,
          "opacity": 0.75
        },
        "outline": 1,
        "status": "textSubtle",
        "series": "series"
      },
      "tooltip": {
        "layout": "two lines above the series rows: (1) period label, caption 500, text; (2) hatched swatch (textSubtle) + status, caption 400, textMuted. Series rows use the hatched series swatch instead of the 10x2 line swatch. Total row as usual.",
        "mobile": "the pinned readout row uses the same two lines, then the series values",
        "strings": "see wording below"
      }
    }
  },
